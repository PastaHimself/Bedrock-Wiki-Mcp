{
  "sources": [
    {
      "id": "ms_creator_docs",
      "name": "Microsoft Minecraft Creator Documentation",
      "type": "git",
      "tier": 1,
      "repository": "https://github.com/MicrosoftDocs/minecraft-creator.git",
      "branch": "main",
      "channel": "stable",
      "include": [
        "creator/Commands/**",
        "creator/Documents/**",
        "creator/Reference/**",
        "creator/ScriptAPI/**",
        "creator/PriorScriptAPI/**"
      ]
    },
    {
      "id": "bedrock_samples_stable",
      "name": "Mojang Bedrock Samples (Stable)",
      "type": "git",
      "tier": 2,
      "repository": "https://github.com/Mojang/bedrock-samples.git",
      "branch": "main",
      "channel": "stable"
    },
    {
      "id": "bedrock_samples_preview",
      "name": "Mojang Bedrock Samples (Preview)",
      "type": "git",
      "tier": 2,
      "repository": "https://github.com/Mojang/bedrock-samples.git",
      "branch": "preview",
      "channel": "preview",
      "defaultEnabled": false
    },
    {
      "id": "minecraft_samples",
      "name": "Microsoft Minecraft Samples",
      "type": "git",
      "tier": 2,
      "repository": "https://github.com/microsoft/minecraft-samples.git",
      "branch": "main",
      "channel": "stable"
    },
    {
      "id": "minecraft_scripting_libraries",
      "name": "Mojang Minecraft Scripting Libraries",
      "type": "git",
      "tier": 2,
      "repository": "https://github.com/Mojang/minecraft-scripting-libraries.git",
      "branch": "main",
      "channel": "stable",
      "include": [
        "README.md",
        "libraries/**"
      ]
    },
    {
      "id": "minecraft_debugger",
      "name": "Mojang Minecraft Bedrock Debugger Documentation",
      "type": "git",
      "tier": 2,
      "repository": "https://github.com/Mojang/minecraft-debugger.git",
      "branch": "main",
      "channel": "stable",
      "include": [
        "README.md"
      ]
    },
    {
      "id": "minecraft_creator_tools",
      "name": "Mojang Minecraft Creator Tools",
      "type": "git",
      "tier": 3,
      "repository": "https://github.com/Mojang/minecraft-creator-tools.git",
      "branch": "main",
      "channel": "stable",
      "sparsePaths": [
        "app/jsnode"
      ],
      "include": [
        "README.md",
        "CHANGELOG.md",
        "ProjectStructure.md",
        "app/jsnode/README.md"
      ]
    },
    {
      "id": "bedrock_oss_wiki",
      "name": "Bedrock Wiki (Community)",
      "type": "git",
      "tier": 3,
      "repository": "https://github.com/Bedrock-OSS/bedrock-wiki.git",
      "branch": "wiki",
      "channel": "stable",
      "sparsePaths": [
        "docs"
      ],
      "include": [
        "docs/*.md",
        "docs/*.mdx",
        "docs/**/*.md",
        "docs/**/*.mdx"
      ],
      "exclude": [
        "docs/contribute*.md",
        "docs/discord.md",
        "docs/hacktoberfest.md",
        "docs/graph-test.md"
      ]
    },
    {
      "id": "bedrock_oss_examples",
      "name": "Bedrock OSS Examples (Community)",
      "type": "git",
      "tier": 3,
      "repository": "https://github.com/Bedrock-OSS/bedrock-examples.git",
      "branch": "main",
      "channel": "stable",
      "sparsePaths": [
        "resources"
      ],
      "include": [
        "resources/**/*.json",
        "resources/**/*.js",
        "resources/**/*.ts",
        "resources/**/*.mcfunction",
        "resources/**/*.md"
      ]
    },
    {
      "id": "bridge_core_docs",
      "name": "bridge. Editor Documentation",
      "type": "git",
      "tier": 3,
      "repository": "https://github.com/bridge-core/docs.git",
      "branch": "main",
      "channel": "stable",
      "defaultEnabled": true,
      "sparsePaths": [
        "docs"
      ],
      "include": [
        "README.md",
        "docs/**/*.md",
        "docs/**/*.mdx"
      ]
    },
    {
      "id": "bridge_core_editor_packages",
      "name": "bridge. Editor Packages and Schemas",
      "type": "git",
      "tier": 3,
      "repository": "https://github.com/bridge-core/editor-packages.git",
      "branch": "main",
      "channel": "stable",
      "defaultEnabled": true,
      "sparsePaths": [
        "packages"
      ],
      "include": [
        "README.md",
        "packages/**/*.json",
        "packages/**/*.md"
      ]
    },
    {
      "id": "blockception_language_server",
      "name": "Blockception Minecraft Bedrock Language Server",
      "type": "git",
      "tier": 3,
      "repository": "https://github.com/Blockception/minecraft-bedrock-language-server.git",
      "branch": "main",
      "channel": "stable",
      "defaultEnabled": true,
      "sparsePaths": [
        "documentation",
        "ide",
        "packages",
        "tools"
      ],
      "include": [
        "README.md",
        "documentation/**/*.md",
        "documentation/**/*.json",
        "ide/**/*.md",
        "ide/**/*.js",
        "ide/**/*.ts",
        "packages/**/*.md",
        "packages/**/*.js",
        "packages/**/*.json",
        "packages/**/*.ts",
        "tools/**/*.md",
        "tools/**/*.js",
        "tools/**/*.json",
        "tools/**/*.ts"
      ],
      "exclude": [
        "**/test/**",
        "**/tests/**",
        "**/coverage/**",
        "**/dist/**"
      ]
    },
    {
      "id": "blockception_json_schemas",
      "name": "Blockception Minecraft Bedrock JSON Schemas",
      "type": "git",
      "tier": 3,
      "repository": "https://github.com/Blockception/Minecraft-bedrock-json-schemas.git",
      "branch": "main",
      "channel": "stable",
      "defaultEnabled": true,
      "sparsePaths": [
        "behavior",
        "docs",
        "general",
        "language",
        "resource",
        "skinpacks",
        "source",
        "worldgen"
      ],
      "include": [
        "README.md",
        "behavior/**/*.json",
        "docs/**/*.md",
        "general/**/*.json",
        "language/**/*.json",
        "resource/**/*.json",
        "skinpacks/**/*.json",
        "source/**/*.json",
        "worldgen/**/*.json"
      ]
    },
    {
      "id": "jayly_scriptapi",
      "name": "Jayly Community Minecraft Script API Samples",
      "type": "git",
      "tier": 3,
      "repository": "https://github.com/JaylyDev/ScriptAPI.git",
      "branch": "stable",
      "channel": "stable",
      "defaultEnabled": true,
      "sparsePaths": [
        "packages",
        "scripts",
        "tools"
      ],
      "include": [
        "README.md",
        "packages/**/*.js",
        "packages/**/*.json",
        "packages/**/*.md",
        "packages/**/*.ts",
        "scripts/**/*.js",
        "scripts/**/*.json",
        "scripts/**/*.md",
        "scripts/**/*.ts",
        "tools/**/*.js",
        "tools/**/*.json",
        "tools/**/*.md",
        "tools/**/*.ts"
      ]
    },
    {
      "id": "blockbench",
      "name": "Blockbench Model Editor and Bedrock Formats",
      "type": "git",
      "tier": 3,
      "repository": "https://github.com/JannisX11/blockbench.git",
      "branch": "master",
      "channel": "stable",
      "defaultEnabled": true,
      "sparsePaths": [
        "content",
        "js",
        "types"
      ],
      "include": [
        "README.md",
        "content/**/*.md",
        "js/**/*.js",
        "js/**/*.json",
        "types/**/*.d.ts",
        "types/**/*.ts"
      ],
      "exclude": [
        "js/libs/**",
        "**/node_modules/**",
        "**/build/**",
        "**/assets/**"
      ]
    },
    {
      "id": "jannis_bedrock_schemas",
      "name": "JannisX11 Bedrock JSON Schemas (Historical)",
      "type": "git",
      "tier": 3,
      "repository": "https://github.com/JannisX11/bedrock-json-schemas.git",
      "branch": "master",
      "channel": "unknown",
      "defaultEnabled": true,
      "include": [
        "README.md",
        "*.json"
      ],
      "exclude": [
        "package.json"
      ]
    },
    {
      "id": "nusiq_mcblend",
      "name": "Mcblend Bedrock Modeling and Animation Guides",
      "type": "git",
      "tier": 3,
      "repository": "https://github.com/Nusiq/mcblend.git",
      "branch": "master",
      "channel": "stable",
      "defaultEnabled": true,
      "sparsePaths": [
        "docs"
      ],
      "include": [
        "README.md",
        "docs/**/*.md",
        "docs/**/*.json"
      ]
    },
    {
      "id": "bedrock_core_server",
      "name": "bedrock-core Addon Interoperability Framework",
      "type": "git",
      "tier": 3,
      "repository": "https://github.com/bedrock-core/server.git",
      "branch": "main",
      "channel": "stable",
      "defaultEnabled": true,
      "sparsePaths": [
        "packages",
        "types"
      ],
      "include": [
        "README.md",
        "packages/**/*.js",
        "packages/**/*.json",
        "packages/**/*.md",
        "packages/**/*.ts",
        "types/**/*.json",
        "types/**/*.ts"
      ],
      "exclude": [
        "**/__tests__/**",
        "**/test/**",
        "**/tests/**",
        "**/coverage/**"
      ]
    },
    {
      "id": "minecraft_addon_toolchain",
      "name": "Minecraft Addon Toolchain (Historical)",
      "type": "git",
      "tier": 3,
      "repository": "https://github.com/minecraft-addon-tools/minecraft-addon-toolchain.git",
      "branch": "master",
      "channel": "unknown",
      "defaultEnabled": true,
      "sparsePaths": [
        "packages"
      ],
      "include": [
        "README.md",
        "packages/**/*.js",
        "packages/**/*.json",
        "packages/**/*.md"
      ]
    },
    {
      "id": "bedrock_schemas_preview",
      "name": "Mojang Bedrock Schemas (Preview)",
      "type": "git",
      "tier": 1,
      "repository": "https://github.com/Mojang/bedrock-schemas.git",
      "branch": "main",
      "channel": "preview",
      "defaultEnabled": false,
      "sparsePaths": [
        "schemas"
      ],
      "include": [
        "README.md",
        "schemas/*.json",
        "schemas/**/*.json"
      ]
    },
    {
      "id": "bedrock_protocol_docs_preview",
      "name": "Mojang Bedrock Network Protocol Documentation (Preview Head)",
      "type": "git",
      "tier": 1,
      "repository": "https://github.com/Mojang/bedrock-protocol-docs.git",
      "branch": "main",
      "channel": "preview",
      "defaultEnabled": false,
      "sparsePaths": [
        "additional_docs",
        "json"
      ],
      "include": [
        "README.md",
        "additional_docs/*.md",
        "additional_docs/**/*.md",
        "json/*.json",
        "json/**/*.json"
      ]
    },
    {
      "id": "minecraft_scripting_samples_preview",
      "name": "Microsoft Minecraft Scripting Samples (Beta APIs)",
      "type": "git",
      "tier": 2,
      "repository": "https://github.com/microsoft/minecraft-scripting-samples.git",
      "branch": "main",
      "channel": "preview",
      "defaultEnabled": false
    },
    {
      "id": "minecraft_gametests_preview",
      "name": "Microsoft Minecraft GameTests (Beta APIs)",
      "type": "git",
      "tier": 2,
      "repository": "https://github.com/microsoft/minecraft-gametests.git",
      "branch": "main",
      "channel": "preview",
      "defaultEnabled": false
    },
    {
      "id": "minecraft_editor_preview",
      "name": "Mojang Minecraft Bedrock Editor (Preview)",
      "type": "git",
      "tier": 2,
      "repository": "https://github.com/Mojang/minecraft-editor.git",
      "branch": "main",
      "channel": "preview",
      "defaultEnabled": false,
      "include": [
        "README.md"
      ]
    },
    {
      "id": "minecraft_editor_extension_samples_preview",
      "name": "Mojang Minecraft Editor Extension Samples (Preview)",
      "type": "git",
      "tier": 2,
      "repository": "https://github.com/Mojang/minecraft-editor-extension-samples.git",
      "branch": "main",
      "channel": "preview",
      "defaultEnabled": false
    },
    {
      "id": "minecraft_editor_extension_starter_preview",
      "name": "Mojang Minecraft Editor Extension Starter Kit (Preview)",
      "type": "git",
      "tier": 2,
      "repository": "https://github.com/Mojang/minecraft-editor-extension-starter-kit.git",
      "branch": "main",
      "channel": "preview",
      "defaultEnabled": false
    }
  ]
}
