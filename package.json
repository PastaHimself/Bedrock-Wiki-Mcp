{
  "name": "bedrock-wiki-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for searching Minecraft Bedrock add-on documentation, samples, schemas, and Script API metadata.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "bedrock-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js serve",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.2.0",
    "sqlite-vec": "0.1.9"
  },
  "overrides": {
    "onnxruntime-node": {
      "adm-zip": "0.6.0"
    },
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@types/node": "24.11.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
