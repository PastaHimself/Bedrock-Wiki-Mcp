# Replace bedrock-mcp.example.com with the public hostname.
# Caddy obtains/renews TLS certificates automatically when the hostname is
# publicly reachable and DNS resolves to this host.

bedrock-mcp.example.com {
    encode zstd gzip

    # Keep the upstream private. Caddy preserves the original Host header,
    # allowing BEDROCK_MCP_ALLOWED_HOSTS to validate the public hostname.
    reverse_proxy 127.0.0.1:8080 {
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    log
}
