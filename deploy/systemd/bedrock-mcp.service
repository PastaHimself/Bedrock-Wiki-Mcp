[Unit]
Description=Bedrock Wiki MCP server
Documentation=https://github.com/PastaHimself/Bedrock-Wiki-Mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bedrock-mcp
Group=bedrock-mcp
WorkingDirectory=/opt/bedrock-wiki-mcp
EnvironmentFile=/etc/bedrock-mcp/bedrock-mcp.env
ExecStart=/usr/bin/node /opt/bedrock-wiki-mcp/dist/index.js serve
Restart=on-failure
RestartSec=5s
# The first start may download and load the Qwen GGUF model.
TimeoutStartSec=20min
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

# The serving process reads the published index and source metadata, and may
# populate the local model cache on first startup. Scheduled synchronization/
# indexing is performed by a separate unit.
ReadOnlyPaths=/var/lib/bedrock-mcp
ReadWritePaths=/var/lib/bedrock-mcp/models/huggingface

[Install]
WantedBy=multi-user.target
