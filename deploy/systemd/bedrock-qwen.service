[Unit]
Description=Local Qwen model server for Bedrock Wiki MCP
Documentation=https://huggingface.co/Qwen/Qwen3-1.7B-GGUF
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bedrock-mcp
Group=bedrock-mcp
WorkingDirectory=/var/lib/bedrock-mcp
Environment=HOME=/var/lib/bedrock-mcp
Environment=HF_HOME=/var/lib/bedrock-mcp/huggingface
ExecStart=/usr/local/bin/llama-server -hf Qwen/Qwen3-1.7B-GGUF:Q8_0 --host 127.0.0.1 --port 8081 --ctx-size 4096 --parallel 1
ExecStartPost=/usr/bin/bash /opt/bedrock-wiki-mcp/deploy/scripts/wait-for-local-llm.sh http://127.0.0.1:8081/health 900
Restart=on-failure
RestartSec=5s
TimeoutStartSec=15min
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

ReadWritePaths=/var/lib/bedrock-mcp/huggingface

[Install]
WantedBy=multi-user.target
