NODE_ENV=production
BEDROCK_MCP_HOST=127.0.0.1
BEDROCK_MCP_PORT=8080
BEDROCK_MCP_DATA_DIR=/var/lib/bedrock-mcp
BEDROCK_MCP_LOG_LEVEL=info

# Set this to the public hostname accepted by the reverse proxy or Cloudflare Tunnel.
BEDROCK_MCP_ALLOWED_HOSTS=bedrock-mcp.example.com

# Leave empty unless browser-originated clients need an Origin header.
BEDROCK_MCP_ALLOWED_ORIGINS=

# Immediate proxy IPs allowed to provide CF-Connecting-IP for per-client rate limiting.
# Leave empty for generic reverse proxies. The Cloudflare Tunnel VPS profile documents
# when it is safe to set this to 127.0.0.1.
BEDROCK_MCP_TRUSTED_PROXY_IPS=

# Optional if your MCP client supports bearer authentication.
# BEDROCK_MCP_BEARER_TOKEN=replace-with-a-long-random-secret

BEDROCK_MCP_MAX_REQUEST_BYTES=524288
# Conservative production override for a 2-vCPU host. The application default is 32.
BEDROCK_MCP_MAX_CONCURRENT_REQUESTS=8
BEDROCK_MCP_RATE_LIMIT_PER_MINUTE=120

# Optional semantic retrieval. The updater downloads/caches the model and rebuilds
# semantic.db before the read-only server is restarted. Leave false on low-RAM hosts.
# This only ranks evidence; it does not generate answers.
BEDROCK_MCP_SEMANTIC_ENABLED=false
BEDROCK_MCP_SEMANTIC_MODEL=onnx-community/all-MiniLM-L6-v2-ONNX
BEDROCK_MCP_SEMANTIC_TOP_K=40

# Administrative update settings used by bedrock-mcp-update.service.
BEDROCK_MCP_CHECKOUT_ROOT=/var/lib/bedrock-mcp/sources
# The 7 GiB corpus-heavy profile includes all configured stable and preview sources.
# Preview evidence remains gated by retrieval intent/filters after it is indexed.
BEDROCK_MCP_INCLUDE_PREVIEW=true
# Keep one recoverable snapshot so source checkouts and indexes can use most of a
# 7 GiB volume without seven full database copies consuming the disk.
BEDROCK_MCP_BACKUP_RETAIN=1
# Keep 768 MiB free in addition to the updater's estimated backup/rebuild headroom.
BEDROCK_MCP_MIN_FREE_BYTES=805306368
