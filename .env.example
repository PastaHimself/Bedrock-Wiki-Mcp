NODE_ENV=development
BEDROCK_MCP_HOST=127.0.0.1
BEDROCK_MCP_PORT=8080
BEDROCK_MCP_DATA_DIR=./data
BEDROCK_MCP_LOG_LEVEL=info

# Leave empty for local development. In production, set the public hostname.
BEDROCK_MCP_ALLOWED_HOSTS=
BEDROCK_MCP_ALLOWED_ORIGINS=

# Immediate proxy IPs allowed to provide CF-Connecting-IP for per-client rate limiting.
# Leave empty unless Node is directly behind a trusted Cloudflare Tunnel proxy.
BEDROCK_MCP_TRUSTED_PROXY_IPS=

# Optional. If set, every /mcp request must send Authorization: Bearer <token>.
# Minimum 16 characters.
# BEDROCK_MCP_BEARER_TOKEN=replace-with-a-long-random-secret

BEDROCK_MCP_MAX_REQUEST_BYTES=524288
BEDROCK_MCP_MAX_CONCURRENT_REQUESTS=32
BEDROCK_MCP_RATE_LIMIT_PER_MINUTE=120

# Optional local semantic retrieval. Leave disabled for the lowest RAM/disk usage.
BEDROCK_MCP_SEMANTIC_ENABLED=false
BEDROCK_MCP_SEMANTIC_MODEL=onnx-community/all-MiniLM-L6-v2-ONNX
BEDROCK_MCP_SEMANTIC_TOP_K=40
